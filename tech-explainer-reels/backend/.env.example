PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/tech-explainer-reels

# JWT - use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Google Gemini API key (https://aistudio.google.com/app/apikey) - server-side only
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-flash-latest   # for the fastest replies try a "lite" Flash model your key has access to (e.g. gemini-2.5-flash-lite)
# AI_MAX_OUTPUT_TOKENS=500           # cap on tutor answer length (shorter = faster)

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Max video upload size in MB (default 100)
MAX_UPLOAD_MB=100

# Used ONLY by `npm run create-admin` (choose your own strong password; min 10 chars)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Content moderation (all optional; defaults shown) ---
# MODERATION_REVIEW_RISK=40        # screening risk score (0-100) at/above which a human must review the lesson
# TRUST_MIN_APPROVED=3             # published lessons (and zero rejections) after which a creator is trusted automatically
# MODERATION_AUDIT_RATE=0.1        # share of auto-approved lessons queued for an admin spot-check
# MODERATION_REPORT_THRESHOLD=3    # distinct viewers reporting a lesson hides it until an admin reviews it
